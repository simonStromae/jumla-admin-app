generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  client
  agent
  admin
  driver
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  phone              String?
  role               UserRole  @default(client)
  status             String    @default("active")
  emailVerified      Boolean   @default(false)
  verifyToken        String?
  mustChangePassword Boolean   @default(false)
  resetToken         String?
  resetExpiry        DateTime?
  loginAttempts      Int       @default(0)
  lockedAt           DateTime?
  sessionVersion     Int       @default(0)
  permissions        Json      @default("{}")
  city               String?
  country            String    @default("CM")
  addresses          Json?
  clientType         String?   @default("standard")
  clientTypeChosen   Boolean   @default(false)
  defaultDelivery    String?   @default("pickup")
  companyName        String?
  billingAddress     String?
  createdAt          DateTime  @default(now())

  parcels          Parcel[]       @relation("ClientParcels")
  driverParcels    Parcel[]       @relation("DriverParcels")
  payments         Payment[]
  sentMessages     Message[]       @relation("sender")
  receivedMessages Message[]       @relation("recipient")
  trackingEvents   TrackingEvent[]
  campaignCosts    CampaignCost[]
  campaigns        Campaign[]
  notifications    Notification[]
  invoices         Invoice[]

  @@map("users")
}

model Route {
  id          String     @id @default(cuid())
  origin      String
  destination String
  label       String?
  active      Boolean    @default(true)
  transitDays Int        @default(14)
  currency    String     @default("CAD")
  fees        Json?
  campaigns   Campaign[]

  @@map("routes")
}

model Airline {
  id        String   @id @default(cuid())
  name      String
  iata      String?
  country   String?
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  legs CampaignLeg[]

  @@map("airlines")
}

model Campaign {
  id            String         @id @default(cuid())
  code          String         @unique
  routeId       String
  route         Route          @relation(fields: [routeId], references: [id])
  departureDate DateTime?
  arrivalDate   DateTime?
  status        String         @default("enr")
  statusNotes   Json?
  capacityKg    Float?
  createdById   String?
  createdBy     User?          @relation(fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?

  costs         CampaignCost?
  costItems     CampaignCostItem[]
  legs          CampaignLeg[]
  parcels       Parcel[]
  invoices      Invoice[]

  @@map("campaigns")
}

model CampaignLeg {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  airlineId  String
  airline    Airline  @relation(fields: [airlineId], references: [id])
  awbNumber  String?
  weightKg   Float?
  notes      String?
  createdAt  DateTime @default(now())

  @@map("campaign_legs")
}

model CampaignCost {
  campaignId  String   @id
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fret        Int      @default(0)
  manutention Int      @default(0)
  douane      Int      @default(0)
  entrepot    Int      @default(0)
  transport   Int      @default(0)
  divers      Int      @default(0)
  enteredById String?
  enteredBy   User?    @relation(fields: [enteredById], references: [id])
  updatedAt   DateTime @updatedAt

  @@map("campaign_costs")
}

model CampaignCostItem {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  label      String
  amountXaf  Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("campaign_cost_items")
}

model Parcel {
  id            String       @id @default(cuid())
  clientId      String
  client        User         @relation("ClientParcels", fields: [clientId], references: [id])
  campaignId    String
  campaign      Campaign     @relation(fields: [campaignId], references: [id])
  trackingCode  String       @unique
  description   String?
  weightKg      Float?
  declaredValue Float?
  priceXaf      Int?
  // Tarification
  productType       String?  @default("standard")
  nbCartons         Int?     @default(0)
  nbPetitsSacs      Int?     @default(0)
  nbSacsMoyens      Int?     @default(0)
  nbGrandsSacs      Int?     @default(0)
  nbPlastiques      Int?     @default(0)
  nbPlastiquesBiere Int?     @default(0)
  nbCasiers24x65    Int?     @default(0)
  nbCasiers24x33    Int?     @default(0)
  nbCasiers12x50    Int?     @default(0)
  marginPct         Float?   @default(30)
  pricingDetails    Json?
  items             Json?
  recipName         String?
  recipPhone        String?
  recipCity         String?
  confirmedPriceXaf Int?
  adjustmentStatus  String?  @default("none")
  delivery          String?  @default("pickup")
  driverId          String?
  driver            User?    @relation("DriverParcels", fields: [driverId], references: [id])
  deliveredAt       DateTime?
  deliveryProof     Json?
  // Disclaimer légal avant réservation
  hasValuable           Boolean   @default(false)
  coverageFee           Int?
  waiverAccepted        Boolean   @default(false)
  forbiddenAcknowledged Boolean   @default(false)
  disclaimerAcceptedAt  DateTime?
  bordereaux        Bordereau[]
  status        String       @default("enr")
  confirmed     Boolean      @default(false)
  notes         String?
  createdAt          DateTime     @default(now())
  deletedAt          DateTime?
  cancellationReason String?
  notifyTarget       String?  @default("sender") // sender | recipient | both | custom
  notifyPhone        String?
  notifyEmail        String?

  payment        Payment?
  trackingEvents TrackingEvent[]
  notifications  Notification[]

  @@map("parcels")
}

model Payment {
  id         String        @id @default(cuid())
  parcelId   String        @unique
  parcel     Parcel        @relation(fields: [parcelId], references: [id])
  clientId   String
  client     User          @relation(fields: [clientId], references: [id])
  amount     Int
  status     String        @default("pending")
  interacRef String?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  @@map("payments")
}

model TrackingEvent {
  id          String       @id @default(cuid())
  parcelId    String
  parcel      Parcel       @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  status      String
  location    String?
  note        String?
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@map("tracking_events")
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("sender", fields: [senderId], references: [id])
  recipientId String
  recipient   User      @relation("recipient", fields: [recipientId], references: [id])
  campaignId  String?
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("messages")
}

model Bordereau {
  id                String    @id @default(cuid())
  parcelId          String
  parcel            Parcel    @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  code              String
  description       String?
  weightKg          Float?
  nbPieces          Int       @default(1)
  items             Json?
  status            String    @default("en_attente")
  notes             String?
  clientConfirmed   Boolean   @default(false)
  clientConfirmedAt DateTime?
  createdAt         DateTime  @default(now())

  @@map("bordereaux")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model WhatsappLog {
  id        String   @id @default(cuid())
  parcelId  String?
  toPhone   String
  body      String
  status    String   @default("pending")
  twilioSid String?
  error     String?
  sentAt    DateTime @default(now())

  @@map("whatsapp_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  parcelId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcel Parcel? @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model Invoice {
  id         String    @id @default(cuid())
  number     String    @unique
  clientId   String
  client     User      @relation(fields: [clientId], references: [id])
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  amountXaf  Int
  status     String    @default("draft") // draft | sent | paid | overdue
  notes      String?
  issuedAt   DateTime?
  dueAt      DateTime?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("invoices")
}
